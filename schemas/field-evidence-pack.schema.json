{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titans-cognition.local/schemas/field-evidence-pack-v1.json",
  "title": "TITANS field evidence pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "physical_identity",
    "raw_physical_fact",
    "preparation_disposition",
    "normalized_lexical_form",
    "tokens",
    "protected_phrases",
    "abbreviation_observations",
    "generic_attribute_observations",
    "technical_observations",
    "contextual_evidence",
    "candidate_qualifier_observations",
    "conflicts",
    "unresolved_items",
    "applied_rule_ids",
    "provenance",
    "evidence_status"
  ],
  "$defs": {
    "physicalColumnId": {"type": "string", "minLength": 1},
    "ruleId": {"type": "string", "pattern": "^(GEN|TF)-[A-Z]+-[0-9]{3}$"},
    "sourceKind": {
      "enum": ["COLUMN_NAME", "COLUMN_COMMENT", "OBJECT_NAME", "OBJECT_COMMENT"]
    },
    "sourceSpan": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "evidenceStatus": {
      "enum": ["SUPPORT", "CONTRADICT", "CONTEXT_ONLY", "NOT_APPLICABLE", "NOT_OBSERVED"]
    }
  },
  "properties": {
    "physical_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "object_name", "object_type", "physical_column_id"],
      "properties": {
        "schema_name": {"type": "string", "minLength": 1},
        "object_name": {"type": "string", "minLength": 1},
        "object_type": {"enum": ["TABLE", "VIEW", "MATERIALIZED_VIEW", "SYNONYM"]},
        "physical_column_id": {"$ref": "#/$defs/physicalColumnId"}
      }
    },
    "raw_physical_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_comment_raw", "column_name_raw", "column_comment_raw", "data_type_raw", "nullable", "ordinal_position"],
      "properties": {
        "object_comment_raw": {"type": ["string", "null"]},
        "column_name_raw": {"type": "string", "minLength": 1},
        "column_comment_raw": {"type": ["string", "null"]},
        "data_type_raw": {"type": "string", "minLength": 1},
        "nullable": {"type": "boolean"},
        "ordinal_position": {"type": "integer", "minimum": 1}
      }
    },
    "preparation_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_code", "downstream_workset"],
      "properties": {
        "status": {"enum": ["PREPARED", "EXCLUDED", "DEFERRED"]},
        "reason_code": {"type": ["string", "null"]},
        "downstream_workset": {"type": ["string", "null"]}
      }
    },
    "normalized_lexical_form": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["physical_column_id", "source_kind", "raw_value", "normalized_value", "source_span", "source_ref", "information_loss", "review_required", "rule_ids"],
        "properties": {
          "physical_column_id": {"$ref": "#/$defs/physicalColumnId"},
          "source_kind": {"$ref": "#/$defs/sourceKind"},
          "raw_value": {"type": "string"},
          "normalized_value": {"type": "string"},
          "source_span": {"$ref": "#/$defs/sourceSpan"},
          "source_ref": {"type": "string", "minLength": 1},
          "information_loss": {"type": "boolean"},
          "review_required": {"type": "boolean"},
          "rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ruleId"}}
        }
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["physical_column_id", "token_id", "raw_text", "normalized_text", "source_kind", "source_span", "source_ref", "rule_id"],
        "properties": {
          "physical_column_id": {"$ref": "#/$defs/physicalColumnId"},
          "token_id": {"type": "string", "minLength": 1},
          "raw_text": {"type": "string", "minLength": 1},
          "normalized_text": {"type": "string", "minLength": 1},
          "source_kind": {"$ref": "#/$defs/sourceKind"},
          "source_span": {"$ref": "#/$defs/sourceSpan"},
          "source_ref": {"type": "string", "minLength": 1},
          "rule_id": {"$ref": "#/$defs/ruleId"}
        }
      }
    },
    "protected_phrases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["physical_column_id", "phrase", "source_kind", "source_span", "source_ref", "rule_id", "suppressed_rule_ids", "status"],
        "properties": {
          "physical_column_id": {"$ref": "#/$defs/physicalColumnId"},
          "phrase": {"type": "string", "minLength": 1},
          "source_kind": {"$ref": "#/$defs/sourceKind"},
          "source_span": {"$ref": "#/$defs/sourceSpan"},
          "source_ref": {"type": "string", "minLength": 1},
          "rule_id": {"$ref": "#/$defs/ruleId"},
          "suppressed_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "status": {"enum": ["CANDIDATE", "UNRESOLVED"]}
        }
      }
    },
    "abbreviation_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["physical_column_id", "token_id", "expansion_candidate", "status", "source_kind", "source_span", "source_ref", "rule_id"],
        "properties": {
          "physical_column_id": {"$ref": "#/$defs/physicalColumnId"},
          "token_id": {"type": "string", "minLength": 1},
          "expansion_candidate": {"type": ["string", "null"]},
          "status": {"enum": ["CANDIDATE", "UNRECOGNIZED_ABBREVIATION"]},
          "source_kind": {"$ref": "#/$defs/sourceKind"},
          "source_span": {"$ref": "#/$defs/sourceSpan"},
          "source_ref": {"type": "string", "minLength": 1},
          "rule_id": {"$ref": "#/$defs/ruleId"}
        }
      }
    },
    "generic_attribute_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["physical_column_id", "attribute", "object_anchor_candidate", "status", "source_kind", "source_span", "source_ref", "rule_id"],
        "properties": {
          "physical_column_id": {"$ref": "#/$defs/physicalColumnId"},
          "attribute": {"enum": ["IDENTIFIER_SHAPE", "NUMERIC_SHAPE", "CODE_SHAPE", "NAME_VARIANT_OBSERVATION", "BUSINESS_OBJECT_STATE", "CLASSIFICATION", "MEASURE", "QUANTITY", "RATE", "TIME", "CURRENCY", "DESCRIPTION", "SOURCE_TARGET_TERM"]},
          "object_anchor_candidate": {"type": ["string", "null"]},
          "status": {"enum": ["CANDIDATE", "UNBOUND_ATTRIBUTE_OBSERVATION"]},
          "source_kind": {"$ref": "#/$defs/sourceKind"},
          "source_span": {"$ref": "#/$defs/sourceSpan"},
          "source_ref": {"type": "string", "minLength": 1},
          "rule_id": {"$ref": "#/$defs/ruleId"}
        }
      }
    },
    "technical_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["physical_column_id", "technical_class", "status", "required_context", "source_kind", "source_span", "source_ref", "rule_id"],
        "properties": {
          "physical_column_id": {"$ref": "#/$defs/physicalColumnId"},
          "technical_class": {"enum": ["TECHNICAL_IDENTIFIER", "AUDIT_ACTOR", "AUDIT_TIME", "INGESTION_METADATA", "BATCH_METADATA", "LINEAGE_METADATA", "EXTENSION_SLOT", "SOFT_DELETE", "VERSION_CONTROL", "UNRESOLVED_TECHNICAL"]},
          "status": {"enum": ["CANDIDATE", "UNRESOLVED"]},
          "required_context": {"type": "array", "items": {"type": "string"}},
          "source_kind": {"$ref": "#/$defs/sourceKind"},
          "source_span": {"$ref": "#/$defs/sourceSpan"},
          "source_ref": {"type": "string", "minLength": 1},
          "rule_id": {"$ref": "#/$defs/ruleId"}
        }
      }
    },
    "contextual_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["physical_column_id", "context_id", "context_type", "status", "source_ref", "source_kind", "source_span", "rule_id"],
        "properties": {
          "physical_column_id": {"$ref": "#/$defs/physicalColumnId"},
          "context_id": {"type": "string", "minLength": 1},
          "context_type": {"enum": ["OBJECT", "PRODUCT_CANDIDATE", "BUSINESS_AREA_CANDIDATE", "WIKI_WEAK_CONTEXT", "SIBLING_FIELD"]},
          "status": {"$ref": "#/$defs/evidenceStatus"},
          "source_ref": {"type": "string", "minLength": 1},
          "source_kind": {"$ref": "#/$defs/sourceKind"},
          "source_span": {"$ref": "#/$defs/sourceSpan"},
          "rule_id": {"$ref": "#/$defs/ruleId"}
        }
      }
    },
    "candidate_qualifier_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["physical_column_id", "dimension", "value", "status", "evidence_ref", "source_kind", "source_span", "source_ref", "rule_id"],
        "properties": {
          "physical_column_id": {"$ref": "#/$defs/physicalColumnId"},
          "dimension": {"enum": ["position_side", "trade_side", "cashflow_direction", "variability", "currency_basis"]},
          "value": {"type": "string"},
          "status": {"enum": ["CANDIDATE", "CONFLICT"]},
          "evidence_ref": {"type": "string", "minLength": 1},
          "source_kind": {"$ref": "#/$defs/sourceKind"},
          "source_span": {"$ref": "#/$defs/sourceSpan"},
          "source_ref": {"type": "string", "minLength": 1},
          "rule_id": {"$ref": "#/$defs/ruleId"}
        },
        "allOf": [
          {"if": {"properties": {"dimension": {"const": "position_side"}}, "required": ["dimension"]}, "then": {"properties": {"value": {"enum": ["LONG", "SHORT"]}}}},
          {"if": {"properties": {"dimension": {"const": "trade_side"}}, "required": ["dimension"]}, "then": {"properties": {"value": {"enum": ["BUY", "SELL"]}}}},
          {"if": {"properties": {"dimension": {"const": "cashflow_direction"}}, "required": ["dimension"]}, "then": {"properties": {"value": {"enum": ["PAY", "RECEIVE"]}}}},
          {"if": {"properties": {"dimension": {"const": "variability"}}, "required": ["dimension"]}, "then": {"properties": {"value": {"enum": ["DYNAMIC", "FIXED"]}}}},
          {"if": {"properties": {"dimension": {"const": "currency_basis"}}, "required": ["dimension"]}, "then": {"properties": {"value": {"enum": ["ORIGINAL_CURRENCY", "LOCAL_CURRENCY", "UNDERLYING_CURRENCY", "SETTLEMENT_CURRENCY"]}}}}
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflict_id", "physical_column_id", "conflict_type", "evidence_a", "evidence_b", "candidate_interpretations", "prohibited_auto_resolution", "required_next_evidence", "review_status", "rule_ids", "source_spans"],
        "properties": {
          "conflict_id": {"type": "string", "minLength": 1},
          "physical_column_id": {"$ref": "#/$defs/physicalColumnId"},
          "conflict_type": {"type": "string", "minLength": 1},
          "evidence_a": {"type": "string", "minLength": 1},
          "evidence_b": {"type": "string", "minLength": 1},
          "candidate_interpretations": {"type": "array", "items": {"type": "string"}},
          "prohibited_auto_resolution": {"const": true},
          "required_next_evidence": {"type": "array", "items": {"type": "string"}},
          "review_status": {"enum": ["UNREVIEWED", "DEFERRED"]},
          "rule_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/ruleId"}},
          "source_spans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_kind", "source_span", "source_ref"],
              "properties": {
                "source_kind": {"$ref": "#/$defs/sourceKind"},
                "source_span": {"$ref": "#/$defs/sourceSpan"},
                "source_ref": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["physical_column_id", "code", "reason", "source_kind", "source_span", "source_ref", "rule_id", "required_next_evidence"],
        "properties": {
          "physical_column_id": {"$ref": "#/$defs/physicalColumnId"},
          "code": {"enum": ["NOT_OBSERVED", "UNRECOGNIZED_ABBREVIATION", "UNBOUND_ATTRIBUTE_OBSERVATION", "UNRESOLVED_PROTECTED_PHRASE", "UNRESOLVED_TECHNICAL", "SEMANTIC_LAYER_REQUIRED"]},
          "reason": {"type": "string", "minLength": 1},
          "source_kind": {"$ref": "#/$defs/sourceKind"},
          "source_span": {"$ref": "#/$defs/sourceSpan"},
          "source_ref": {"type": "string", "minLength": 1},
          "rule_id": {"$ref": "#/$defs/ruleId"},
          "required_next_evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "applied_rule_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ruleId"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_artifacts", "injected_source_manifest_id", "injected_source_manifest_sha256"],
      "properties": {
        "source_artifacts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "locator", "evidence_role"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "locator": {"type": "string", "minLength": 1},
              "evidence_role": {"enum": ["COLUMN_PHYSICAL_FACT", "OBJECT_PHYSICAL_FACT", "INJECTED_MANIFEST"]}
            }
          }
        },
        "injected_source_manifest_id": {"type": ["string", "null"]},
        "injected_source_manifest_sha256": {"type": ["string", "null"]}
      }
    },
    "evidence_status": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "evidence_ref"],
        "properties": {
          "status": {"$ref": "#/$defs/evidenceStatus"},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
