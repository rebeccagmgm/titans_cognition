{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cognition-workflow-profile-v1",
  "title": "Cognition Workflow Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "capability", "operations", "required_artifact_roles", "mandatory_checkpoints", "ambiguity_triggers", "model_policy"],
  "properties": {
    "schema_version": {"const": "cognition-workflow-profile-v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "capability": {"const": "semantic-navigation"},
    "operations": {
      "const": ["authority-snapshot", "artifact-integrity", "review-readiness", "final-audit"]
    },
    "required_artifact_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "mandatory_checkpoints": {
      "const": ["PREFLIGHT", "POST_STAGE", "PRE_REVIEW", "POST_REVIEW", "PRE_FINALIZE"]
    },
    "ambiguity_triggers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_calls", "max_total_calls", "max_total_tokens", "require_measured_usage"],
      "properties": {
        "default_calls": {"const": 0},
        "max_total_calls": {"const": 0},
        "max_total_tokens": {"const": 0},
        "require_measured_usage": {"type": "boolean"}
      }
    }
  }
}
